# Copy to .env and fill in. .env holds real secrets and must never be committed.
#
#     cp .env-example .env
#
# Both required variables are declared in docker-compose.yml with ${VAR:?...}, so
# `docker compose up` fails immediately with a named error rather than starting a
# half-configured stack.

# ---------------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------------

# HuggingFace token, used only to download the model weights on first start.
# A read-only token is enough. https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password for the KasmVNC desktop at http://127.0.0.1:6901
# Log in as "kasm_user" -- with an UNDERSCORE. The Linux account inside the container
# is kasm-user with a hyphen, but that is not the web login; using it returns 401.
# The base image ships a well-known default, so always set your own. The startup script
# rewrites the password file from this value on every boot, so changing it here and
# running `docker compose up -d desktop` rotates it (`restart` would keep the old one).
#   generate one:  head -c 18 /dev/urandom | base64 | tr -d '/+=' | head -c 20
VNC_PW=change-me

# ---------------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------------

# Where model weights are cached on the host. Defaults to ~/.cache/huggingface.
# Worth pointing at a roomy disk: this checkpoint is ~22 GiB.
HF_CACHE_DIR=~/hf-cache/huggingface

# ---------------------------------------------------------------------------------
# The desktop container also honours the variables below, but they are set explicitly
# in docker-compose.yml rather than here, because they are wiring rather than secrets.
# Listed so they are discoverable:
#
#   CUA_MODEL_NAME   openai/qwen35-27b        model string for the vision loop.
#                                             MUST contain "qwen35": cua picks its agent
#                                             loop by regex, and a miss silently degrades
#                                             to a weaker generic loop. See the
#                                             --served-model-name comment in the compose
#                                             file.
#   OPENAI_BASE_URL  http://host.docker.internal:8000/v1   how the container reaches vLLM
#   OPENAI_API_KEY   EMPTY                    vLLM ignores it, litellm insists on one
#   CUA_MAX_IMAGES   3                        screenshots kept in the vision loop's
#                                             context; each costs ~1.2-1.6k image tokens
#   VNC_RESOLUTION   1280x800                 requested geometry. KasmVNC resizes the
#                                             display to fit whoever is watching, so
#                                             treat this as a starting point, not a
#                                             guarantee.
#
# And gui-bridge's own defaults, override only if you have a reason:
#   BRIDGE_PORT      8765     inside the container (published on 8766 on the host)
#   TRAJECTORY_DIR   /trajectories
#   BROWSER_PROFILE  /home/kasm-user/.gui-bridge-profile
#   CONSOLE_LIMIT    400      browser console lines kept for browser_console
# ---------------------------------------------------------------------------------
